        },
        {
          "dia": 14,
          "fecha": "2026-03-31",
          "eventos": [
            {
              "hora": "09:00",
              "descripcion": "Laudes + Santa Misa en la Capilla de la Virgen del Carmen"
            }
          ]
        },
        {
          "dia": 15,
          "fecha": "2026-04-01",
          "eventos": [
            {
              "hora": "09:00",
              "descripcion": "Laudes + Santa Misa + Confesiones en la Capilla de la Virgen del Carmen"
            },
            {
              "hora": "18:00-20:00",
              "descripcion": "Confesiones en la Capilla de la Virgen del Carmen"
            },
            {
              "hora": "21:30",
              "descripcion": "Pasos. Cristo del Perdón: Bellísimo paso compuesto por el Perdón, la Verónica y un Romano. El trono lo componen 10 obras de arte con temas religiosos de Clemente Gerez. Acompañado por la banda municipal de música de Mojácar. El Señor de la Misericordia, estremecedor paso 'El Calvario' 1877, perdido y recuperado por el G.A.E. La Cofradía 1987. Compuesto por el Señor de la Misericordia, La Dolorosa y San Juan. Acompañado por la banda municipal de música de Turre. Santísima Virgen de la Amargura, Madre de la Salud, bellísimo trono. Templete, Imagen y Trono recuperado por la Cofradía en 1996, igualmente la corona. Acompañada por la banda municipal de música de Garrucha."
            }
          ]
        },
        {
          "dia": 16,
          "fecha": "2026-04-02",
          "eventos": [
            {
              "hora": "18:30",
              "descripcion": "Santa Misa de la Cena del Señor en el Templo Parroquial"
            },
            {
              "hora": "20:00",
              "descripcion": "Solemne desfile procesional de la Hermandad con los pasos: Ntro. Padre Jesús Nazareno, San Juan Evangelista, Santísima Virgen de los Dolores. Acompañamiento musical: Banda de Música 'Ex Mari Orta' y 'Villa de Alfacar'. Itinerario: Casa Hermandad, Obispo Orberá, Aristóteles, Colón, Mayor, Espronda, Malecón, Méndez-Núñez, Mayor, Colón, Aristóteles, Obispo Orberá, Casa Hermandad."
            },
            {
              "hora": "22:15",
              "descripcion": "Hora Santa en el Monumento con el Santísimo Sacramento"
            }
          ]
        },
        {
          "dia": 17,
          "fecha": "2026-04-03",
          "eventos": [
            {
              "hora": "03:00",
              "descripcion": "Santo Via-Crucis, subida al Calvario de Garrucha. Itinerario: Salida desde Cofradía Misericordia y Amargura, subida al Calvario, colocación de Cruz y bajada a Iglesia."
            },
            {
              "hora": "11:00",
              "descripcion": "Solemne desfile procesional de la Hermandad con los pasos: Santísimo Cristo de la Expiración, María Santísima de Gracia y Amparo, San Juan Evangelista y María Magdalena, María Stma. de la Piedad. Acompañamiento musical: Agrupación Musical Ntro. Padre Jesús Cautivo, Vera y Banda de Música 'Ex Mari Orta'. Itinerario: Casa Hermandad, Obispo Orberá, Aristóteles, Joaquín Escobar, Santo Domingo, Mayor, Colón, Aristóteles, Obispo Orberá, Casa Hermandad."
            },
            {
              "hora": "20:30",
              "descripcion": "Solemne desfile procesional del Santo Entierro de Cristo con el paso: Santo Sepulcro del Redentor. Itinerario: Parroquia, Obispo Orberá, Aristóteles, Colón, Mayor, Méndez Núñez, Cervantes, Santo Domingo, Joaquín Escobar, Aristóteles, Obispo Orberá, parroquia."
            },
            {
              "hora": "22:30",
              "descripcion": "La Soledad. La Stma. Virgen de la Amargura busca a su Hijo muerto. Itinerario: Cervantes, Castillejos, Colón, Mayor, Darro, Cofradía. Todos podrán llevar una vela encendida."
            }
          ]
