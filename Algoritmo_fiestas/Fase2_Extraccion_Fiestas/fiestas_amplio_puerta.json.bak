        },
        {
          "dia": 12,
          "fecha": "2026-03-29",
          "eventos": [
            {
              "hora": "10:15",
              "descripcion": "Reparto de Palmas en la Capilla Virgen del Carmen y bendición. Las Palmas se entregarán previo pago de un donativo simbólico de 8€."
            },
            {
              "hora": "11:00",
              "descripcion": "Procesión de Ramos. Pasos: Nuestro Padre Jesús en su entrada triunfal a Jerusalén, María Stma. de los Angeles, Paso de la Borriquita. Acompañamiento Musical: Banda de Música Ex Mari Orta. Itinerario: Capilla Virgen del Carmen, Rambla, Malecón, Poeta Cano Cervantes, Mayor, Colón, Aristóteles, Obispo Orberá, Casa Hermandad."
            }
          ]
        },
