     "fecha_publicacion": null,
     "captura": "C:\\Users\\Usuario\\PROYECTOS\\DEV-FIESTYFY_0426\\FIESTYFY_algorithm\\Algoritmo_fiestas\\Fase2_Extraccion_Fiestas\\rrss_capturas\\01010000000\\twitter_00.png",
